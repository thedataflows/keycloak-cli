# Sample local .env file
LOG_LEVEL=debug
KEYCLOAK_VERSION=26.7.4
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_BASE_URL=http://keycloak.172.29.0.3.nip.io:8080
## Will be set by `admin-token` command, or automatically when a command
## finds no valid token (uses KEYCLOAK_USERNAME/KC_BOOTSTRAP_ADMIN_* above)
KEYCLOAK_REFRESH_TOKEN=??
KEYCLOAK_ACCESS_TOKEN=??
